---
import { CardGrid } from '@astrojs/starlight/components';
import IconLinkCard from '@src/components/IconLinkCard.astro';
---

<div class="print:hidden">
    <CardGrid>
        <IconLinkCard
            icon="discord" 
            title="Discord"
            description="Ask questions and chat live with the community."
            href="https://discord.com/invite/mtasa" />
        
        <IconLinkCard
            icon="gitter"
            title="Forum"
            description="Engage with the community in the old-fashioned way."
            href="https://forum.multitheftauto.com/forum/82-support-for-mtasa-1x/" />
    </CardGrid>
</div>

<script>
    // Accordion sidebar: close other open dropdowns when one is opened
    function initSidebarAccordion() {
        const sidebarDetails = document.querySelectorAll('nav details');
        
        // Find the active page link (aria-current="page")
        const activeLink = document.querySelector('nav a[aria-current="page"]');
        let activeParentDetails = null;
        if (activeLink) {
            activeParentDetails = activeLink.closest('details');
        }

        sidebarDetails.forEach((details) => {
            // Set name attribute for native accordion behavior in modern browsers
            details.setAttribute('name', 'starlight-sidebar');

            // Keep the active category open, close all others on load
            if (activeParentDetails) {
                if (details === activeParentDetails) {
                    details.open = true;
                } else {
                    details.open = false;
                }
            }

            // Fallback event listener for older browser compatibility
            details.addEventListener('toggle', () => {
                if (details.open) {
                    sidebarDetails.forEach((otherDetails) => {
                        if (otherDetails !== details && otherDetails.open) {
                            otherDetails.open = false;
                        }
                    });
                }
            });
        });
    }

    // Run on page load
    initSidebarAccordion();
    document.addEventListener('astro:page-load', initSidebarAccordion);
</script>


